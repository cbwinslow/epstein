# =============================================================================
# OpenDiscourse Environment Example
# Author: cbwinslow
# Summary: Copy to .env and edit. Never commit secrets.
# =============================================================================

# Postgres
OPENDISCOURSE_DB_HOST=127.0.0.1
OPENDISCOURSE_DB_PORT=5432
OPENDISCOURSE_DB_NAME=opendiscourse
OPENDISCOURSE_DB_USER=opendiscourse
OPENDISCOURSE_DB_PASSWORD=change_me

# Storage
OPENDISCOURSE_STORAGE_ROOT=./documents

# Logging
OPENDISCOURSE_LOG_LEVEL=INFO
OPENDISCOURSE_LOG_DIR=./logs

# Sources
GOVINFO_API_KEY=change_me
