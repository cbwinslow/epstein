# Epstein Files Project Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=analysis
POSTGRES_USER=analysis
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# =============================================================================
# VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# =============================================================================
# AI MODELS (FREE OPTIONS)
# =============================================================================
# Ollama (local, free) - run `ollama serve` and `ollama pull mistral`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenRouter (free tier available) - get key at https://openrouter.ai
# Note: Free models available include: mistral, llama3, etc.
OPENROUTER_API_KEY=

# =============================================================================
# MCP SERVER
# =============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_BASE_URL=http://localhost:8765
MCP_DOWNLOAD_DIR=./downloads
MCP_MAX_CONCURRENT=5

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================
PIPELINE_BATCH_SIZE=10
PIPELINE_CHUNK_SIZE=512
PIPELINE_CHUNK_OVERLAP=50

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# NER model (spacy)
NER_MODEL=en_core_web_sm

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TASKS=50
AGENT_TIMEOUT=3600

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_DIR=./logs

# =============================================================================
# DATA DIRECTORIES
# =============================================================================
DATA_DIR=./data
DOWNLOAD_DIR=./downloads
OCR_DIR=./ocr_output
TEXT_DIR=./text_output
